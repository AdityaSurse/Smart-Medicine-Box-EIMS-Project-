/**
 * Smart Medicine Box (DoseGuard) - ESP32 Firmware Secrets & Configuration
 * 
 * INSTRUCTIONS:
 * 1. Copy this file to "secrets.h" in the same directory:
 *    cp secrets.h.example secrets.h
 * 2. Replace the placeholder values with your real Wi-Fi credentials and Firebase keys.
 * 3. Never commit "secrets.h" to version control (it is ignored in .gitignore).
 */

#ifndef SECRETS_H
#define SECRETS_H

// ==============================================================================
// 1. LOCAL WI-FI NETWORK CONFIGURATION (2.4 GHz Only)
// ==============================================================================
#define WIFI_SSID             "SomebodyGetTheseBeggarsOuttahere"
#define WIFI_PASSWORD         "adi123456"

// Maximum attempts before fallback to offline buffering
#define WIFI_CONNECT_TIMEOUT_MS  15000

// ==============================================================================
// 2. FIREBASE / CLOUD FIRESTORE CREDENTIALS
// ==============================================================================
// Found in Firebase Console -> Project Settings -> General -> Project ID
#define FIREBASE_PROJECT_ID   "smart-medicine-box-29a6d"

// Found in Firebase Console -> Project Settings -> General -> Web API Key
#define FIREBASE_API_KEY      "AIzaSyCxKsrRWDmBpEG4MCAuRTUdI9AihXBADho"

// User UID from Firebase Console -> Authentication -> Users -> Copy UID
// (Must match the account logged into the Android app)
#define FIREBASE_USER_UID     "AId4zDSxR2UjpkiJPV9majjz4gL2"

// Hardware Serial Number / Identifier (matches app's linked device ID)
#define DEVICE_ID             "DG-4081"

// ==============================================================================
// 3. HARDWARE GPIO PIN ASSIGNMENTS (ESP32-WROOM-32 / S3)
// ==============================================================================
// Magnetic Reed Switch on box lid (Active LOW with internal pull-up)
#define PIN_REED_SWITCH       4

// DHT22 Temperature & Humidity Sensor (Data pin)
#define PIN_DHT22             15

// Active Piezo Buzzer
#define PIN_BUZZER            25

// 1.8" Color TFT Display (ST7735 / SPI)
#define PIN_TFT_CS            5
#define PIN_TFT_DC            2
#define PIN_TFT_RST           14
#define PIN_TFT_MOSI          23
#define PIN_TFT_SCK           18

// ==============================================================================
// 4. TIME & NTP CONFIGURATION (No physical RTC required)
// ==============================================================================
#define NTP_SERVER_1          "pool.ntp.org"
#define NTP_SERVER_2          "time.nist.gov"
// Standard Time offset in seconds (e.g. UTC+0 = 0, IST UTC+5:30 = 19800, EST = -18000)
#define GMT_OFFSET_SEC        19800
#define DAYLIGHT_OFFSET_SEC   0

// ==============================================================================
// 5. FIRESTORE REST API PATH TEMPLATES
// ==============================================================================
#define FIRESTORE_HOST        "firestore.googleapis.com"
#define FIRESTORE_PORT        443

// Base collection path: users/{uid}/devices/{deviceId}/
#define FS_BASE_PATH          "v1/projects/" FIREBASE_PROJECT_ID "/databases/(default)/documents/users/" FIREBASE_USER_UID "/devices/" DEVICE_ID

// Telemetry Singleton (PATCH every 30s)
#define FS_TELEMETRY_PATH     FS_BASE_PATH "/telemetry/latest?key=" FIREBASE_API_KEY

// Hardware Events (POST on reed switch open/close)
#define FS_EVENTS_PATH        FS_BASE_PATH "/events?key=" FIREBASE_API_KEY

// Remote Commands (GET / Poll for silence buzzer, etc.)
#define FS_COMMANDS_PATH      FS_BASE_PATH "/commands?key=" FIREBASE_API_KEY

// Hardware Settings (GET / Poll for grace period, quiet hours, buzzer setting)
#define FS_SETTINGS_PATH      FS_BASE_PATH "/settings?key=" FIREBASE_API_KEY

// Schedule Acknowledgment (PATCH with loaded version)
#define FS_SCHEDULE_ACK_PATH  FS_BASE_PATH "/scheduleAck?key=" FIREBASE_API_KEY

// Prescription Schedules (GET to sync display and alarms)
#define FS_SCHEDULES_PATH     "v1/projects/" FIREBASE_PROJECT_ID "/databases/(default)/documents/users/" FIREBASE_USER_UID "/schedules?key=" FIREBASE_API_KEY

#endif // SECRETS_H

